# ---------------------------------------------------------------------------
# Cofoundry — Umgebungsvariablen
#
# Hier stehen bewusst KEINE KI-Schlüssel. Der OpenRouter-Key wird nicht über
# .env gesetzt, sondern im laufenden Betrieb unter /settings hinterlegt und
# mit ENCRYPTION_KEY verschlüsselt in der SQLite-Datenbank abgelegt.
# ---------------------------------------------------------------------------

# 32 Byte als Hex (64 Zeichen). Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Verschlüsselt den OpenRouter-Key in der Datenbank (AES-256-GCM).
# ACHTUNG: Ändert man diesen Wert, ist der gespeicherte Key nicht mehr lesbar.
ENCRYPTION_KEY=

# Mindestens 32 Zeichen. Signiert das Session-Cookie. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Zugangsdaten für den Seed-Account (pnpm db:seed).
# Ohne Angabe wird ein Zufallspasswort erzeugt und auf der Konsole ausgegeben.
SEED_EMAIL=
SEED_PASSWORD=

# Optional: 1 = alle OpenRouter-Aufrufe laufen gegen einen deterministischen
# Mock statt gegen die echte API. Nur für Entwicklung/Tests ohne Netzzugang
# oder ohne Key. Im Normalbetrieb weglassen.
MOCK_OPENROUTER=
